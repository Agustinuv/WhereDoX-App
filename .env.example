# Copy to .env and adjust. Never commit the real .env.

# Local Postgres from docker-compose. The host is the compose service name when the API
# runs in a container; use localhost when running uvicorn on the host.
DATABASE_URL=postgresql+psycopg://wheredox:wheredox@db:5432/wheredox

# Supabase: Database -> Connection string -> URI, via the pooler on port 6543.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Hours before an event that the reminder job considers a session "upcoming".
REMINDER_LEAD_HOURS=24

# How long "recuérdame más tarde" waits before the reminder comes back.
# Worth dropping to 1 or 2 while demoing.
REMINDER_SNOOZE_MINUTES=60

# Telegram. Get the token from @BotFather. Leave it empty and everything still runs:
# the notification port falls back to logging what it would have sent, and only the
# `bot` service refuses to start.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=where_do_x_bot

# Wall clock used in Telegram messages. The database stores UTC and the web client
# converts in the browser; a chat message has no browser to ask.
DISPLAY_TIMEZONE=America/Santiago

# Host port for the API container. Change it if 8000 is already taken on your machine.
API_PORT=8000

# Host port for the web UI container. Change it if 3000 is already taken.
WEB_PORT=3000
